# Modèle installé par deploy/linux/install.sh dans ~/.config/systemd/user/jellyfin-office.service
# (__APP_DIR__ et __NODE__ sont remplacés à l'installation).

[Unit]
Description=Jellyfin en boucle (lecture aléatoire continue sur MPV Shim + interface web)

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__NODE__ __APP_DIR__/dist/server/index.js
Environment=NODE_ENV=production
Environment=PORT=__PORT__
# Écoute sur toutes les interfaces : nécessaire pour localhost (page QR) et pour le téléphone.
Environment=HOST=0.0.0.0
# Optionnel : forcer l'adresse affichée dans le QR code, ou le lecteur à piloter.
#Environment=PUBLIC_URL=http://192.168.1.50:8787
#Environment=PLAYER_DEVICE_ID=
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
